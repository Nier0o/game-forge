# Docker Compose interpolation values.
# Copy to .env in this directory before running docker compose.

# Inter-service auth. Leave empty for local development only.
GEN_SERVICE_SECRET=

# Shared AI provider settings.
GROQ_API_KEY=
PLANNER_PROVIDER=groq
PLANNER_MODEL=qwen/qwen3-32b
CODER_PROVIDER=groq
CODER_MODEL=openai/gpt-oss-120b
THEME_PROVIDER=groq
THEME_MODEL=qwen/qwen3-32b
AUDIO_PROVIDER=groq
AUDIO_MODEL=qwen/qwen3-32b

# Shared object storage credentials.
MINIO_ACCESS_KEY=gameforge
MINIO_SECRET_KEY=change-me-in-production

# Builder option for fast local smoke tests.
SKIP_GODOT_EXPORT=false

# Asset MCP server — image & audio generation.
STABILITY_API_KEY=
SPRITEFLOW_SESSION_TOKEN=
